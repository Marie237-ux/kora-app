{
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "plugins": ["prettier-plugin-astro", "@prettier/plugin-php"],
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": "*.php", "options": { "printWidth": 120, "tabWidth": 4, "phpVersion": "8.3" } }
  ]
}
