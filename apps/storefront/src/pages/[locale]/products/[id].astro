---
import Base from '../../../layouts/Base.astro';
import { t } from '@kora/ui';
import { formatXaf } from '@kora/design-tokens';
import {
  ApiError,
  createApi,
  type Locale,
  type Offer,
  type PublicCategory,
} from '@kora/api-client';
const locale = Astro.params.locale as Locale;
if (!['fr', 'en'].includes(locale)) return new Response(null, { status: 404 });
const copy = t(locale);
let offer: Offer | null = null;
let failed = false;
let categories: PublicCategory[] = [];
try {
  const api = createApi(import.meta.env.API_INTERNAL_URL || 'http://localhost:8000', locale);
  const [o, c] = await Promise.all([api.offer(Astro.params.id || ''), api.categories()]);
  offer = o.data;
  categories = c.data;
} catch (e) {
  if (e instanceof ApiError && e.status === 404) return new Response(null, { status: 404 });
  failed = true;
}
const category = categories.find((c) => c.slug === offer?.category);
const labels =
  locale === 'fr'
    ? { features: 'Caractéristiques', yes: 'Oui', no: 'Non', minimum: 'Quantité minimale' }
    : { features: 'Specifications', yes: 'Yes', no: 'No', minimum: 'Minimum quantity' };
---

<Base locale={locale} title={offer?.name || copy.product}>
  <a class="button-link" href={'/' + locale + '/catalogue'}>
    ← {copy.backCatalogue}
  </a>
  {failed ? (
    <p class="error">{copy.dataUnavailable}</p>
  ) : (
    offer && (
      <article class="product-detail">
        <div class="visual">
          {offer.image ? (
            <img src={offer.image} alt={offer.name} width="600" height="500" />
          ) : (
            <p class="muted">{copy.noImage}</p>
          )}
        </div>
        <div>
          <p class="eyebrow">{offer.category}</p>
          <h1>{offer.name}</h1>
          <p>
            {copy.soldBy} <a href={'/' + locale + '/shops/' + offer.shop.slug}>{offer.shop.name}</a>
          </p>
          <p class="hero-price">{formatXaf(offer.price.amount, locale)}</p>
          <p class="badge">{copy[offer.availability]}</p>
          <p class="muted">{offer.description}</p>
          <h2 style="font-size:1.4rem">{copy.warranty}</h2>
          <p>{offer.warranty}</p>
          <p>
            {labels.minimum}: {offer.minimum_quantity} · SKU: {offer.sku}
          </p>
          {category && Object.keys(offer.attributes).length > 0 && (
            <>
              <h2 style="font-size:1.4rem">{labels.features}</h2>
              <dl class="attribute-list">
                {category.attributes
                  .filter((def) => offer!.attributes[def.key] !== undefined)
                  .map((def) => {
                    const value = offer!.attributes[def.key];
                    return (
                      <>
                        <dt>{def.label}</dt>
                        <dd>
                          {typeof value === 'boolean'
                            ? value
                              ? labels.yes
                              : labels.no
                            : def.type === 'choice'
                              ? (def.options.find((o) => o.value === value)?.label ?? String(value))
                              : String(value)}
                          {def.unit ? ' ' + def.unit : ''}
                        </dd>
                      </>
                    );
                  })}
              </dl>
            </>
          )}
          <p class="notice">{copy.development}</p>
        </div>
      </article>
    )
  )}
</Base>
