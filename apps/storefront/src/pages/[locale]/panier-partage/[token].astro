---
/**
 * Shared cart (spec §10): what someone shared — references and quantities only, never their address or details —
 * with today's prices, and a button that copies it into the visitor's own cart. Revocable link, never indexed.
 */
import Site from '../../../layouts/Site.astro';
import PageHero from '../../../components/PageHero.astro';
import LinkAction from '../../../components/LinkAction.tsx';
import { localeOf, api, safe } from '../../../lib/server';
import { cmsPage } from '../../../lib/cms';
import { pagesCopy } from '../../../lib/pages-copy';
import { money } from '../../../lib/copy';
const locale = localeOf(Astro.params.locale);
const token = Astro.params.token ?? '';
if (!locale || !/^[A-Za-z0-9_-]{16,128}$/.test(token)) return new Response(null, { status: 404 });
const p = pagesCopy(locale);
const home = '/' + locale;
type Share = { data: { expires_at: string; lines: { offer_id: string; quantity: number; offer: { id: string; name: string; image: string | null; price: { amount: number }; shop: { name: string } } | null }[] } };
const share = (await safe(api(locale).request<Share>('/api/v1/cart-shares/' + token), null as unknown as Share)).value?.data ?? null;
const lines = share?.lines.filter((l) => l.offer) ?? [];
const total = lines.reduce((t, l) => t + l.offer!.price.amount * l.quantity, 0);
const page = await cmsPage(locale, 'commande');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Site locale={locale} title={p.scTitle}>
  <PageHero locale={locale} photo={page.photo} title={p.scTitle} text={p.scText} />
  <section class="featured sheet pg-sheet">
    <div class="wrap">
      {share && lines.length ? (
        <div class="sl kcard">
          <ul class="oc-lines">
            {lines.map((l) => (
              <li>
                <a class="oc-img" href={home + '/products/' + l.offer!.id}>{l.offer!.image && <img src={l.offer!.image} alt="" loading="lazy" />}</a>
                <span class="oc-name"><a href={home + '/products/' + l.offer!.id}><strong>{l.offer!.name}</strong></a><small>{l.offer!.shop.name} · × {l.quantity}</small></span>
                <b>{money(l.offer!.price.amount * l.quantity, locale)}</b>
              </li>
            ))}
          </ul>
          <div class="sl-foot">
            <span>{locale === 'fr' ? 'Total du jour' : 'Today’s total'} <b>{money(total, locale)}</b></span>
            <LinkAction client:visible locale={locale} kind="cart" token={token} />
          </div>
        </div>
      ) : (
        <div class="ac-bempty ac-nobuy">
          <span class="ac-nobuy-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span>
          <h3>{p.scExpired}</h3>
          <p>{p.scExpiredText}</p>
          <a class="btn btn-dark btn-small" href={home + '/catalogue'}>{locale === 'fr' ? 'Voir le catalogue' : 'See the catalogue'}</a>
        </div>
      )}
    </div>
  </section>
</Site>
