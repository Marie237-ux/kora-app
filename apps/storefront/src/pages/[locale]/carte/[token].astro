---
/**
 * Loyalty card seen through its QR code (spec §23): brand, last four digits, status and tier — nothing else. The
 * QR allows neither signing in, nor spending, nor changing the balance. Never indexed.
 */
import Site from '../../../layouts/Site.astro';
import PageHero from '../../../components/PageHero.astro';
import { localeOf, api, safe } from '../../../lib/server';
import { cmsPage } from '../../../lib/cms';
import { pagesCopy } from '../../../lib/pages-copy';
const locale = localeOf(Astro.params.locale);
const token = Astro.params.token ?? '';
if (!locale || !/^[A-Za-z0-9_-]{16,128}$/.test(token)) return new Response(null, { status: 404 });
const p = pagesCopy(locale);
type Card = { data: { card_suffix: string; status: string; program_enabled: boolean; tier: { label: string } | null } };
const card = (await safe(api(locale).request<Card>('/api/v1/loyalty/cards/' + token), null as unknown as Card)).value?.data ?? null;
const page = await cmsPage(locale, 'compte');
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Site locale={locale} title={p.lcTitle}>
  <PageHero locale={locale} photo={page.photo} title={p.lcTitle} text={p.lcText} />
  <section class="featured sheet pg-sheet">
    <div class="wrap">
      {card ? (
        <div class="ac-kcard lc-card" data-on={card.status === 'active'}>
          <div class="ac-kcard-top"><img src="/brand/logo-ink.png" alt="KORA" />{card.tier && <span>{card.tier.label}</span>}</div>
          <p class="ac-kcard-soon">{card.status === 'active' ? p.lcActive : p.lcSuspended}</p>
          <p class="ac-kcard-num">•••• •••• {card.card_suffix}</p>
        </div>
      ) : (
        <div class="ac-bempty ac-nobuy"><h3>{p.lcBad}</h3></div>
      )}
    </div>
  </section>
</Site>
