---
/**
 * Shop page, as a profile: cover photo (back office) running up under the header, profile photo with ring, name with
 * the verified badge, @handle, district, product and aisle counts, description and sharing. Below, the shop's own
 * catalogue with the same filters, sort and pagination as the catalogue (shared view, scoped to this shop).
 * Room is kept in the profile for following, stories, reporting and blocking once they exist (no fake buttons).
 */
import CatalogueView from '../../../components/CatalogueView.astro';
import { ApiError } from '@kora/api-client';
import { copy } from '../../../lib/copy';
import { api, localeOf, safe } from '../../../lib/server';
const locale = localeOf(Astro.params.locale);
if (!locale) return new Response(null, { status: 404 });
const c = copy(locale);
const k = api(locale);
const home = '/' + locale;
const slug = Astro.params.slug ?? '';
let shop;
try {
  shop = (await k.shop(slug)).data;
} catch (e) {
  if (e instanceof ApiError && e.status === 404) return new Response(null, { status: 404 });
  throw e;
}
if (shop.slug !== slug) return Astro.redirect(home + '/shops/' + encodeURIComponent(shop.slug) + Astro.url.search, 301);
type Option = { value: string; label: string; count: number };
const facets = (await safe(k.request<{ data: { total: number; categories?: Option[] } }>('/api/v1/catalogue/facets?shop=' + encodeURIComponent(shop.slug)), { data: { total: 0, categories: [] } })).value.data;
const aisles = facets.categories?.length ?? 0;
const place = [shop.district, shop.city].filter(Boolean).join(', ');
// Share links are prefilled only; nothing is sent until the visitor confirms in the chosen app.
const pageUrl = new URL(Astro.url.pathname, import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).href;
const shareMsg = shop.name + ' sur KORA — ' + pageUrl;
const icons: Record<string, string> = {"wa": "<path fill=\"currentColor\" stroke=\"none\" d=\"M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.28-.2-.57-.35m-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41Z\" />", "fb": "<path fill=\"currentColor\" stroke=\"none\" d=\"M9.1 23.69v-7.98H6.63v-3.67H9.1v-1.58c0-4.09 1.85-5.98 5.86-5.98.4 0 .96.04 1.47.1.39.05.77.11 1.14.2v3.32a8.6 8.6 0 0 0-.65-.03 26.8 26.8 0 0 0-.73-.01c-.71 0-1.26.1-1.68.31-.28.14-.52.36-.68.62-.26.42-.37 1-.37 1.75v1.3h3.92l-.39 2.1-.29 1.56h-3.24v8.25C19.4 23.24 24 18.18 24 12.04c0-6.62-5.37-12-12-12S0 5.42 0 12.04c0 5.63 3.87 10.35 9.1 11.65Z\" />", "x": "<path fill=\"currentColor\" stroke=\"none\" d=\"M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.47l8.6-9.83L0 1.15h7.59l5.25 6.93ZM17.61 20.64h2.04L6.49 3.24H4.3Z\" />", "tg": "<path fill=\"currentColor\" stroke=\"none\" d=\"M11.94 0A12 12 0 1 0 24 12 12 12 0 0 0 11.94 0Zm5.57 8.16-1.97 9.3c-.15.66-.54.82-1.09.51l-3-2.21-1.45 1.4c-.16.16-.3.3-.6.3l.21-3.05 5.56-5.02c.24-.21-.05-.33-.38-.12l-6.87 4.33-2.96-.92c-.64-.2-.66-.64.14-.95l11.57-4.46c.53-.2 1 .13.84.89Z\" />", "mail": "<rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"3\" /><path d=\"m4 7 8 6 8-6\" />"};
const shares = [
  { key: 'wa', label: 'WhatsApp', href: 'https://wa.me/?text=' + encodeURIComponent(shareMsg) },
  { key: 'fb', label: 'Facebook', href: 'https://www.facebook.com/sharer/sharer.php?u=' + encodeURIComponent(pageUrl) },
  { key: 'x', label: 'X', href: 'https://twitter.com/intent/tweet?text=' + encodeURIComponent(shareMsg) },
  { key: 'tg', label: 'Telegram', href: 'https://t.me/share/url?url=' + encodeURIComponent(pageUrl) + '&text=' + encodeURIComponent(shop.name) },
  { key: 'mail', label: c.shareEmail, href: 'mailto:?subject=' + encodeURIComponent(shop.name + ' · KORA') + '&body=' + encodeURIComponent(shareMsg) },
];
---

<CatalogueView locale={locale} shop={{ slug: shop.slug, name: shop.name }}>
  <section slot="hero" class="shop-head">
    {/* Cover photo from the back office (shop form); without one, a plain tint — the profile photo is never stretched. */}
    <div class={'shop-cover' + (shop.cover ? ' has-photo' : '')} aria-hidden="true">
      {shop.cover && <img src={shop.cover} alt="" decoding="async" fetchpriority="high" />}
    </div>
    <div class="wrap shop-profile">
      {shop.avatar ? (
        <button type="button" class="shop-av" data-avatar-open aria-label={c.viewProfilePhoto + ' — ' + shop.name}>
          <img src={shop.avatar} alt="" decoding="async" />
        </button>
      ) : (
        <span class="shop-av" aria-hidden="true">{shop.name.slice(0, 1)}</span>
      )}
      <div class="shop-id">
        <nav class="crumbs" aria-label={c.breadcrumb}>
          <a href={home}>{c.home}</a><span aria-hidden="true">/</span>
          <a href={home + '/shops'}>{c.ourShopsNav}</a><span aria-hidden="true">/</span>
          <span aria-current="page">{shop.name}</span>
        </nav>
        <h1>
          {shop.name}
          <span class="vendor-badge" role="img" aria-label={c.verified}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 12.3 3.6 3.6 7.4-7.6" /></svg></span>
        </h1>
        <p class="shop-handle">@{shop.slug}{place && <> · {place}</>}</p>
        <ul class="shop-stats">
          <li><strong>{facets.total}</strong> {facets.total > 1 ? c.productsCount : c.productOne}</li>
          <li><strong>{aisles}</strong> {aisles > 1 ? c.aislesWord : c.aisleWord}</li>
        </ul>
        {shop.description && <p class="shop-bio">{shop.description}</p>}
      </div>
      <div class="shop-actions">
        <button type="button" class="save-btn shop-like-lg" data-like-shop={shop.slug} data-like-id={shop.id} data-save-name={shop.name} aria-pressed="false" aria-label={c.likeShop + ' — ' + shop.name}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20.2s-7.4-4.5-9.1-9.2C1.7 7.6 4 4.4 7.3 4.4c2 0 3.6 1.1 4.7 2.8 1.1-1.7 2.7-2.8 4.7-2.8 3.3 0 5.6 3.2 4.4 6.6-1.7 4.7-9.1 9.2-9.1 9.2Z" /></svg></button>
        <div class="share-wrap">
          <button type="button" class="shop-share" data-share-toggle aria-haspopup="menu" aria-expanded="false" data-share={shop.name}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 15V3M7.5 7.5 12 3l4.5 4.5" /><path d="M5 12v6.5A2.5 2.5 0 0 0 7.5 21h9a2.5 2.5 0 0 0 2.5-2.5V12" /></svg>
            <span>{c.share}</span>
          </button>
          <div class="share-pop" role="menu" aria-label={c.share} data-share-pop hidden>
            <p class="share-title">{c.shareShop}</p>
            {shares.map((sh) => <a href={sh.href} target={sh.key === 'mail' ? undefined : '_blank'} rel="noopener" class={'share-' + sh.key} role="menuitem"><span class="share-ico"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[sh.key]} /></span>{sh.label}</a>)}
            <button type="button" class="share-copy" role="menuitem" data-share-copy={pageUrl} data-copied={c.linkCopied}><span class="share-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1" /><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1" /></svg></span><span>{c.copyLink}</span></button>
            <button type="button" class="share-more" role="menuitem" data-share-native hidden><span class="share-ico"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="5" cy="12" r="1.6" /><circle cx="12" cy="12" r="1.6" /><circle cx="19" cy="12" r="1.6" /></svg></span>{c.moreOptions}</button>
          </div>
        </div>
      </div>
    </div>
  </section>
  {shop.avatar && (
    <dialog slot="hero" class="av-zoom" data-avatar-dialog aria-label={shop.name}>
      <img src={shop.avatar} alt={shop.name} width="480" height="480" />
      <p>{shop.name}</p>
      <button type="button" class="av-zoom-x" data-avatar-close aria-label={c.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg></button>
    </dialog>
  )}
</CatalogueView>

<script>
  // Profile photo: opens large in a dialog (at its own size, never stretched); a click outside or Escape closes it.
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const dialog = document.querySelector<HTMLDialogElement>('[data-avatar-dialog]');
    if (!dialog) return;
    if (t.closest('[data-avatar-open]')) dialog.showModal();
    else if (t.closest('[data-avatar-close]') || t === dialog) dialog.close();
  });
  // Share menu: WhatsApp, Facebook, X, Telegram, e-mail (prefilled links), copy the link, and the phone's own share
  // sheet when there is one. Opens under the button; a click outside or Escape closes it.
  const pop = () => document.querySelector<HTMLElement>('[data-share-pop]');
  const toggleBtn = () => document.querySelector<HTMLButtonElement>('[data-share-toggle]');
  function setOpen(on: boolean) {
    const p = pop();
    if (!p) return;
    p.hidden = !on;
    toggleBtn()?.setAttribute('aria-expanded', String(on));
    if (on) p.querySelector<HTMLElement>('a, button:not([hidden])')?.focus();
  }
  const native = document.querySelector<HTMLButtonElement>('[data-share-native]');
  if (native && 'share' in navigator) native.hidden = false;
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-share-toggle]')) return setOpen(pop()?.hidden ?? false);
    const copy = t.closest<HTMLButtonElement>('[data-share-copy]');
    if (copy) {
      try {
        await navigator.clipboard.writeText(copy.dataset.shareCopy ?? location.href);
        const label = copy.querySelector('span:last-child');
        if (label) {
          const before = label.textContent;
          label.textContent = copy.dataset.copied ?? '';
          setTimeout(() => (label.textContent = before), 1600);
        }
      } catch {
        /* clipboard refused */
      }
      return;
    }
    if (t.closest('[data-share-native]')) {
      navigator.share?.({ title: toggleBtn()?.dataset.share, url: location.origin + location.pathname }).catch(() => {});
      return setOpen(false);
    }
    if (t.closest('[data-share-pop] a')) return setOpen(false);
    if (!t.closest('[data-share-pop]')) setOpen(false);
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>
