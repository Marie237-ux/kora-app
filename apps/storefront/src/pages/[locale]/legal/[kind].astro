---
/**
 * Legal documents (terms of sale, terms of use, privacy, returns): the version currently in force, written and
 * published in the back office (CMS → legal), with its version number and date. Nothing is invented here: while a
 * document has no published version, the page says so.
 */
import Site from '../../../layouts/Site.astro';
import { copy } from '../../../lib/copy';
import { api, localeOf, safe } from '../../../lib/server';
const locale = localeOf(Astro.params.locale);
if (!locale) return new Response(null, { status: 404 });
const kinds = ['terms_of_sale', 'terms_of_use', 'privacy', 'returns'] as const;
const kind = Astro.params.kind as (typeof kinds)[number];
if (!kinds.includes(kind)) return new Response(null, { status: 404 });
const c = copy(locale);
const title = { terms_of_sale: c.termsOfSale, terms_of_use: c.termsOfUse, privacy: c.privacy, returns: c.returnsPolicy }[kind];
type Legal = { data: { number: number; body: Record<string, string> | string; effective_at: string } };
const doc = (await safe(api(locale).request<Legal>('/api/v1/legal/' + kind), null as unknown as Legal)).value?.data ?? null;
const text = doc ? (typeof doc.body === 'string' ? doc.body : doc.body[locale] ?? doc.body.fr ?? '') : '';
const blocks = text.split(/\n{2,}/).map((b) => b.trim()).filter(Boolean);
const date = doc ? new Intl.DateTimeFormat(locale === 'fr' ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(doc.effective_at)) : '';
const others = kinds.filter((k) => k !== kind);
const label = (k: (typeof kinds)[number]) => ({ terms_of_sale: c.termsOfSale, terms_of_use: c.termsOfUse, privacy: c.privacy, returns: c.returnsPolicy })[k];
---

<Site locale={locale} title={title}>
  <section class="lg-head">
    <div class="wrap">
      <nav class="crumbs" aria-label={c.breadcrumb}><a href={'/' + locale}>{c.home}</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></nav>
      <h1>{title}</h1>
      {doc && <p>{locale === 'fr' ? 'Version ' + doc.number + ' · en vigueur depuis le ' + date : 'Version ' + doc.number + ' · in force since ' + date}</p>}
    </div>
  </section>
  <div class="lg-area">
    <div class="wrap lg-grid">
      <article class="lg-doc">
        {blocks.length ? blocks.map((b) => (/^#{1,3}\s/.test(b) ? <h2>{b.replace(/^#{1,3}\s/, '')}</h2> : <p>{b}</p>)) : (
          <p class="lg-wait">{locale === 'fr' ? 'Ce document est en cours de rédaction et sera publié ici très bientôt.' : 'This document is being written and will be published here very soon.'}</p>
        )}
      </article>
      <aside class="lg-side">
        {others.map((k) => <a href={'/' + locale + '/legal/' + k}>{label(k)} →</a>)}
      </aside>
    </div>
  </div>
</Site>

<style is:global>
  .lg-head { padding: 34px 0 30px; }
  .lg-head h1 { margin: 14px 0 0; font-family: var(--serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 400; letter-spacing: -0.015em; }
  .lg-head p { margin: 8px 0 0; color: var(--muted); font-size: 0.9rem; }
  .lg-area { padding: 34px 0 72px; background: #f3f2ef; }
  :root[data-theme='dark'] .lg-area { background: #1b1916; }
  body:has(.lg-area) .site-footer { margin-top: 0; }
  .lg-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 20px; align-items: start; }
  .lg-doc { padding: 32px 36px; border-radius: 24px; background: var(--bg); box-shadow: 0 1px 2px rgba(20, 20, 20, 0.04), 0 10px 30px rgba(20, 20, 20, 0.05); }
  :root[data-theme='dark'] .lg-doc, :root[data-theme='dark'] .lg-side { background: #252320; box-shadow: none; }
  .lg-doc h2 { margin: 26px 0 8px; font-size: 1.1rem; }
  .lg-doc h2:first-child { margin-top: 0; }
  .lg-doc p { max-width: 70ch; margin: 0 0 14px; color: var(--ink-2); line-height: 1.65; white-space: pre-line; }
  .lg-wait { color: var(--muted) !important; }
  .lg-side { display: grid; padding: 10px 0; border-radius: 20px; background: var(--bg); box-shadow: 0 1px 2px rgba(20, 20, 20, 0.04), 0 10px 30px rgba(20, 20, 20, 0.05); }
  .lg-side a { padding: 12px 22px; font-size: 0.92rem; font-weight: 600; color: var(--ink-2); }
  .lg-side a:hover { color: var(--accent); }
  @media (max-width: 760px) {
    .lg-grid { grid-template-columns: 1fr; }
    .lg-doc { padding: 20px 18px; border-radius: 20px; }
    .lg-doc p { font-size: 0.92rem; }
  }
</style>
