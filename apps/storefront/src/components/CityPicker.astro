---
/**
 * "I receive my order in…": the visitor's city, used by every list with filters (catalogue, shop page, our shops,
 * inspirations). Cities that have shops come first with a count (from the API facets), the others are marked
 * "shipping". "Only in my city" keeps what can be delivered locally. Fields: ma (city) and local (1), inside the
 * page's filter form; the choice is remembered in a cookie (lib/city.ts) so every page knows it.
 */
import { copy, type Locale } from '../lib/copy';
import { CITIES } from '../lib/cities';
interface Props {
  locale: Locale;
  myCity: string;
  onlyLocal: boolean;
  /** City → number of items there (products, shops or boards). */
  counts: Record<string, number>;
  /** Word after the count: [one, many]. */
  unit: [string, string];
}
const { locale, myCity, onlyLocal, counts, unit } = Astro.props;
const c = copy(locale);
const withShops = CITIES.filter((x) => counts[x]).map((x) => ({ city: x, count: counts[x] }));
const others = CITIES.filter((x) => !counts[x]);
---

<details class="fgroup fdeliver" open>
  <summary>{c.deliveryFilter}</summary>
  <details class="cpick">
    <summary>
      <span class="cpick-pin"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-6.1-7-11.5A7 7 0 0 1 19 9.5C19 14.9 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></svg></span>
      <span class="cpick-text"><small>{c.receiveIn}</small><strong>{myCity || c.anywhereCameroon}</strong></span>
      <i class="cpick-caret" aria-hidden="true"></i>
    </summary>
    <div class="cpick-panel">
      <label class="cpick-search">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <span class="sr-only">{c.searchCity}</span>
        <input type="search" placeholder={c.searchCity} autocomplete="off" data-city-search />
      </label>
      <div class="cpick-list" role="radiogroup" aria-label={c.receiveIn}>
        <label class="cpick-opt"><input type="radio" name="ma" value="" checked={!myCity} data-auto /><span>{c.anywhereCameroon}</span></label>
        {withShops.length > 0 && <p class="cpick-group">{c.citiesWithShops}</p>}
        {withShops.map((x) => <label class="cpick-opt" data-city={x.city}><input type="radio" name="ma" value={x.city} checked={myCity === x.city} data-auto /><span>{x.city}</span><small>{x.count} {x.count > 1 ? unit[1] : unit[0]}</small></label>)}
        <p class="cpick-group">{c.otherCities}</p>
        {others.map((x) => <label class="cpick-opt" data-city={x}><input type="radio" name="ma" value={x} checked={myCity === x} data-auto /><span>{x}</span><small>{c.shippingWord}</small></label>)}
        <p class="cpick-none" data-city-none hidden>{c.noCity}</p>
      </div>
    </div>
  </details>
  {myCity && <label class="fswitch"><input type="checkbox" name="local" value="1" checked={onlyLocal} data-auto /><span>{c.onlyMyCity}</span><b aria-hidden="true"><em></em></b></label>}
  <p class="fnote">{c.shipNote}</p>
</details>
